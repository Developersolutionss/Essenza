# ---- Servidor ----
PORT=3000
# Interfaz donde escucha. 127.0.0.1 (por defecto) = solo local: en el VPS se
# publica a través de un proxy inverso con HTTPS (nginx, Caddy).
HOST=127.0.0.1
# Ponlo a 1 cuando haya un proxy inverso delante, para que el bloqueo por
# intentos fallidos vea la IP real del visitante y no la del proxy.
# TRUST_PROXY=1
# Las cookies llevan Secure solas cuando la conexión es HTTPS. Solo toca esto
# para forzarlo: 1 siempre, 0 nunca.
# COOKIE_SECURE=1

# ---- Zona horaria y jornada ----
# Zona de la agencia, para días, horarios y gráficas. Vacío = la del sistema.
TIMEZONE=America/Bogota
# Minutos de gracia por defecto antes de contar una llegada tarde
LATE_GRACE_MINUTES=10
# Margen para distinguir "llegó muy tarde" de "llegó muy temprano al turno siguiente"
# EARLY_MAX_HOURS=4
# Reglas de turno
# SHIFT_HOURS=8
# BREAK_MINUTES=30

# ---- Voz ----
ELEVENLABS_API_KEY=
# Máximo de caracteres por audio (protege el presupuesto)
# MAX_TEXT_CHARS=1000

# ---- Bot de Discord (discord.com/developers/applications) ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcional: ID del servidor, para que los comandos aparezcan al instante
DISCORD_GUILD_ID=

# ---- Accesos web ----
# Panel de administración en /admin. Sin esto, el panel queda desactivado.
ADMIN_PASSWORD=
# Web de chatters en /. Sin esto queda desactivada y los audios solo se generan
# desde Discord. Ponla solo si los chatters van a usar la web.
CHATTER_PASSWORD=
