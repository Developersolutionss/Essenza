PORT=3000
ELEVENLABS_API_KEY=

# Bot de Discord (discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcional: ID del servidor, para que los comandos aparezcan al instante
DISCORD_GUILD_ID=

# Panel de administrador web (/admin). Sin esto el panel queda desactivado.
ADMIN_PASSWORD=

# Zona horaria para horarios de entrada y gráficas (ej. America/Bogota). Vacío = la del sistema.
TIMEZONE=
# Minutos de gracia por defecto antes de contar una llegada tarde
LATE_GRACE_MINUTES=10
# Reglas de turno (opcionales)
# SHIFT_HOURS=8
# BREAK_MINUTES=30
